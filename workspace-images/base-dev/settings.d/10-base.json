{
  "_comment": "Tier 1 settings manifest (global). Owned by base-dev; applied to every workspace. Child images drop sibling Tier 2 settings into the same dir; tier order is by filename sort, later wins on collisions. Extensions live in a sibling extensions.d/ tree.",

  "user": {
    "workbench.colorTheme": "Solarized Moon",
    "pokechi.position": "explorer",
    "window.menuBarVisibility": "classic",
    "claudeCode.preferredLocation": "panel",
    "workbench.activityBar.location": "top",
    "chat.viewSessions.orientation": "stacked",
    "mdb.showOverviewPageAfterInstall": false,
    "editor.fontFamily": "Cascadia Mono, Consolas, monospace",
    "editor.fontLigatures": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true
  },
  "machine": {
    "git.useIntegratedAskPass": false,
    "github.copilot.enable": { "*": true },
    "continue.enableTabAutocomplete": false,
    "likec4.mcp.enabled": true,
    "remote.autoForwardPortsSource": "process",
    "todoforge.general.tags": ["BUG", "HACK", "FIXME", "TODO", "XXX", "STUB", "OUTLINED", "IMPLEMENTED", "REVIEWED"],
    "todoforge.general.strictTags": ["BUG", "STUB", "OUTLINED", "IMPLEMENTED", "REVIEWED"],
    "todoforge.highlighting.tags": {
      "BUG": { "icon": "bug" },
      "HACK": { "icon": "tools" },
      "FIXME": { "icon": "flame" },
      "XXX": { "icon": "x" },
      "STUB": { "icon": "circle-slash", "foreground": "#9e9e9e" },
      "OUTLINED": { "icon": "checklist", "foreground": "#e0a800" },
      "IMPLEMENTED": { "icon": "tools", "foreground": "#3b82f6" },
      "REVIEWED": { "icon": "check", "foreground": "#22c55e" }
    },
    "todoforge.tree.groupBy": "tag",
    "todoforge.scanning.mode": "currentFile"
  }
}
