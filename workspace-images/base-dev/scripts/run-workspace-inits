#!/bin/sh
set -eu
INIT_DIR="${INIT_DIR:-/usr/local/share/workspace-init.d}"
STATUS=0
RUNNER_STARTED_AT="$(date +%s)"

# Each line carries its timing so a slow start shows which script cost what.
if [ -d "$INIT_DIR" ]; then
  for s in $(ls "$INIT_DIR"/*.sh 2>/dev/null | sort); do
    script_name="$(basename "$s")"
    script_started_at="$(date +%s)"
    echo "[init-runner] RUN ${script_name} ($(date -u +%H:%M:%SZ))"
    if "$s"; then
      echo "[init-runner] OK  ${script_name} ($(($(date +%s) - script_started_at))s)"
    else
      rc=$?
      echo "[init-runner] ERR ${script_name} (exit ${rc}, $(($(date +%s) - script_started_at))s)"
      STATUS=1
    fi
  done
fi

TOTAL_SECONDS=$(($(date +%s) - RUNNER_STARTED_AT))
if [ "$STATUS" -ne 0 ]; then
  echo "[init-runner] done (with errors) in ${TOTAL_SECONDS}s."
else
  echo "[init-runner] done in ${TOTAL_SECONDS}s."
fi

exit "$STATUS"
